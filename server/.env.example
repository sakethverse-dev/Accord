# ==============================================================================
# Accord Production Environment Variables
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas URI)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/accord?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication Secrets
# Generate a secure random 64-character secret for production
JWT_SECRET=accord_production_jwt_secret_key_generate_random_hash_here_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Client URLs (comma-separated for multiple origins)
# Example: https://accord-app.vercel.app,https://your-custom-domain.com
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini AI API Key (for dynamic contract auditing fallback chain)
GEMINI_API_KEY=
